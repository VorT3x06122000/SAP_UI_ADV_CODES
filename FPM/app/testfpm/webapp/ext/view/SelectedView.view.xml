<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="testfpm.ext.view.SelectedView"
    xmlns:macrosTable="sap.fe.macros.table"
>
    <Page
        id="SelectedView"
        title="{i18n>SelectedViewTitle}"
    >
        <content>
        <!-- <Text text="Navigated to second screen - user can add required building blocks here"></Text> -->
        <macros:Table
            id="IDSelectedRowsTable"
            metaPath="/EditDataSet/@com.sap.vocabularies.UI.v1.LineItem#tableMacro1"
            header="Selected Rows"
        >
            <macros:actions>
                <macrosTable:Action
                    key="saveButton"
                    id="IDSave"
                    text="Save"
                    press="onSave"
                />
            </macros:actions>
        </macros:Table>
        </content>
        
    </Page>
</mvc:View>
